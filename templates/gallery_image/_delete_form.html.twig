<form method="post"
      action="{{ path('app_gallery_image_delete', {'id': gallery_image.id}) }}"
      class="js-confirm-form"
      data-confirm-message="Supprimer définitivement cette image ?">

    <input type="hidden"
           name="_token"
           value="{{ csrf_token('delete' ~ gallery_image.id) }}">

    <button class="admin-delete-btn">
        Supprimer l’image
    </button>

</form>
