{% extends 'base.html.twig' %}

{% block title %}Modifier {{ gallery_image.title }} - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Modifier {{ gallery_image.title }}</h1>
                <p>Mettez à jour les informations et l’image affichée dans la galerie.</p>
            </div>

            <a href="{{ path('app_gallery_image_index') }}" class="admin-back-btn">
                Retour à la galerie
            </a>
        </div>

        <div class="admin-form-card">

            {{ form_start(form) }}

            <div class="admin-form-grid">
                {{ form_row(form.title) }}
                {{ form_row(form.imageUrl) }}
                {{ form_row(form.isActive) }}
                {{ form_row(form.createdAt) }}
                {{ form_row(form.description) }}
            </div>

            <button type="submit" class="admin-submit-btn">
                Enregistrer les modifications
            </button>

            {{ form_rest(form) }}
            {{ form_end(form) }}

            <div class="admin-form-actions">
                <a href="{{ path('app_gallery_image_show', {'id': gallery_image.id}) }}" class="admin-action-link">
                    Voir l’image
                </a>

                <a href="{{ path('app_admin') }}" class="admin-action-link">
                    Retour au dashboard
                </a>
            </div>

        </div>

    </div>
</section>

{% endblock %}