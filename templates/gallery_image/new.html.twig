{% extends 'base.html.twig' %}

{% block title %}Ajouter une image - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Ajouter une image</h1>
                <p>Créez une nouvelle image pour la galerie publique.</p>
            </div>

            <a href="{{ path('app_gallery_image_index') }}" class="admin-back-btn">
                Retour à la galerie
            </a>
        </div>

        <div class="admin-form-card">

            {{ form_start(form) }}

                <div class="admin-form-grid">
                    {{ form_row(form.title) }}
                    {{ form_row(form.imageFile) }}
                    {{ form_row(form.isActive) }}
                    {{ form_row(form.createdAt) }}
                    {{ form_row(form.description) }}
                </div>

                <button type="submit" class="admin-submit-btn">
                    Créer l’image
                </button>

                {{ form_rest(form) }}

            {{ form_end(form) }}

            <div class="admin-form-actions">
                <a href="{{ path('app_gallery_image_index') }}" class="admin-action-link">
                    Retour à la liste
                </a>

                <a href="{{ path('app_dashboard_redirect') }}" class="admin-action-link">
                    Retour au dashboard
                </a>
            </div>

        </div>

    </div>
</section>

{% endblock %}