{% extends 'base.html.twig' %}

{% block title %}{{ gallery_image.title }} - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>{{ gallery_image.title }}</h1>
                <p>Détail de l’image sélectionnée.</p>
            </div>

            <a href="{{ path('app_gallery_image_index') }}" class="admin-back-btn">
                Retour à la galerie
            </a>
        </div>

        <div class="admin-detail-card">

            <div class="admin-detail-grid">

                <div class="admin-detail-section">
                    <h2>Informations de l’image</h2>

                    <p><strong>ID :</strong> #{{ gallery_image.id }}</p>
                    <p><strong>Titre :</strong> {{ gallery_image.title }}</p>
                    <p><strong>Description :</strong> {{ gallery_image.description ?: 'Aucune description.' }}</p>

                    <p>
                        <strong>Active :</strong>
                        {% if gallery_image.isActive %}
                            <span class="order-status order-status-confirmee">Oui</span>
                        {% else %}
                            <span class="order-status order-status-annulee">Non</span>
                        {% endif %}
                    </p>

                    <p>
                        <strong>Créée le :</strong>
                        {{ gallery_image.createdAt ? gallery_image.createdAt|date('d/m/Y H:i') : 'Non renseigné' }}
                    </p>
                </div>

                <div class="admin-detail-section">
                    <h2>Aperçu</h2>

                    {% if gallery_image.imageUrl %}
                        <img src="{{ asset('uploads/gallery/' ~ gallery_image.imageUrl) }}"
                             alt="{{ gallery_image.title }}"
                             class="menu-admin-main-image">
                    {% else %}
                        <p>Aucune image renseignée.</p>
                    {% endif %}
                </div>

            </div>

            <div class="admin-detail-actions">

                <a href="{{ path('app_gallery_image_edit', {'id': gallery_image.id}) }}"
                   class="admin-action-link admin-action-edit">
                    Modifier l’image
                </a>

                {{ include('gallery_image/_delete_form.html.twig') }}

                <a href="{{ path('app_dashboard_redirect') }}"
                   class="admin-action-link">
                    Retour au dashboard
                </a>

            </div>

        </div>

    </div>
</section>

{% endblock %}