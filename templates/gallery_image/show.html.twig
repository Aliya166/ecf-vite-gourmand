{% extends 'base.html.twig' %}

{% block title %}GalleryImage{% endblock %}

{% block body %}
    <h1>GalleryImage</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ gallery_image.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ gallery_image.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ gallery_image.description }}</td>
            </tr>
            <tr>
                <th>ImageUrl</th>
                <td>{{ gallery_image.imageUrl }}</td>
            </tr>
            <tr>
                <th>IsActive</th>
                <td>{{ gallery_image.isActive ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ gallery_image.createdAt ? gallery_image.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_gallery_image_index') }}">back to list</a>

    <a href="{{ path('app_gallery_image_edit', {'id': gallery_image.id}) }}">edit</a>

    {{ include('gallery_image/_delete_form.html.twig') }}
{% endblock %}
