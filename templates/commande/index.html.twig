{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes - Vite & Gourmand{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Gestion des commandes</h1>
                <p>Consultez et gérez les commandes clients.</p>
            </div>

            <a href="{{ path('app_admin') }}" class="admin-back-btn">
                Retour au dashboard
            </a>
        </div>

        {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
        {% endfor %}

        <div class="employee-filter-card">

            <form method="get" action="{{ path('app_commande_index') }}"
                class="employee-filter-form employee-filter-form-large">

                <div class="filter-field">
                    <label>Client</label>
                    <input type="text" name="client" value="{{ clientSearch }}" placeholder="Nom, prénom ou email">
                </div>

                <div class="filter-field">
                    <label>Statut</label>

                    <select name="status">

                        <option value="">Tous</option>

                        <option value="en_attente" {{ selectedStatus=='en_attente' ? 'selected' : '' }}>
                            En attente
                        </option>

                        <option value="confirmee" {{ selectedStatus=='confirmee' ? 'selected' : '' }}>
                            Confirmée
                        </option>

                        <option value="en_preparation" {{ selectedStatus=='en_preparation' ? 'selected' : '' }}>
                            En préparation
                        </option>

                        <option value="prete" {{ selectedStatus=='prete' ? 'selected' : '' }}>
                            Prête
                        </option>

                        <option value="livree" {{ selectedStatus=='livree' ? 'selected' : '' }}>
                            Livrée
                        </option>

                        <option value="en_attente_retour_materiel" {{ selectedStatus=='en_attente_retour_materiel'
                            ? 'selected' : '' }}>
                            Retour matériel
                        </option>

                        <option value="terminee" {{ selectedStatus=='terminee' ? 'selected' : '' }}>
                            Terminée
                        </option>

                        <option value="annulee" {{ selectedStatus=='annulee' ? 'selected' : '' }}>
                            Annulée
                        </option>

                    </select>
                </div>

                <div class="filter-field">
                    <label>Menu</label>

                    <select name="menu">

                        <option value="">Tous les menus</option>

                        {% for menu in menus %}
                        <option value="{{ menu.id }}" {{ selectedMenu==menu.id ? 'selected' : '' }}>
                            {{ menu.title }}
                        </option>
                        {% endfor %}

                    </select>
                </div>

                <div class="filter-field">
                    <label>Date début</label>

                    <input type="date" name="dateStart" value="{{ dateStart }}">
                </div>

                <div class="filter-field">
                    <label>Date fin</label>

                    <input type="date" name="dateEnd" value="{{ dateEnd }}">
                </div>

                <div class="filter-actions">

                    <button type="submit" class="admin-submit-btn">
                        Rechercher
                    </button>

                    <a href="{{ path('app_commande_index') }}" class="admin-back-btn">
                        Réinitialiser
                    </a>

                </div>

            </form>

        </div>

        <div class="admin-table-card">

            {% if commandes is empty %}
            <p class="admin-empty">
                Aucune commande pour le moment.
            </p>
            {% else %}

            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Client</th>
                            <th>Contact</th>
                            <th>Menu</th>
                            <th>Date livraison</th>
                            <th>Personnes</th>
                            <th>Total</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for commande in commandes %}
                        <tr>
                            <td>#{{ commande.id }}</td>

                            <td>
                                <strong>
                                    {{ commande.user.firstname ?? '' }}
                                    {{ commande.user.lastname ?? '' }}
                                </strong>
                                <br>
                                <small>{{ commande.user.email }}</small>
                            </td>

                            <td>
                                <small>
                                    {{ commande.user.phone ?? 'Téléphone non renseigné' }}
                                    <br>
                                    {{ commande.adresseLivraison }}
                                    <br>
                                    {{ commande.villeLivraison }}
                                </small>
                            </td>

                            <td>
                                {{ commande.menu ? commande.menu.title : 'Menu supprimé' }}
                            </td>

                            <td>
                                <strong>{{ commande.dateLivraison|date('d/m/Y') }}</strong>
                                <br>
                                <small>{{ commande.heureLivraison|date('H:i') }}</small>
                            </td>

                            <td>
                                {{ commande.nombrePersonnes }}
                            </td>

                            <td>
                                <strong>{{ commande.prixTotal|number_format(2, ',', '') }} €</strong>
                            </td>

                            <td>
                                <span class="order-status order-status-{{ commande.status }}">
                                    {{ commande.status|replace({'_': ' '})|capitalize }}
                                </span>
                            </td>

                            <td>
                                <div class="admin-actions">
                                    <a href="{{ path('app_commande_show', {'id': commande.id}) }}"
                                        class="admin-action-link">
                                        Voir
                                    </a>

                                    <a href="{{ path('app_commande_edit', {'id': commande.id}) }}"
                                        class="admin-action-link admin-action-edit">
                                        Modifier
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% endif %}

        </div>

    </div>
</section>

{% endblock %}