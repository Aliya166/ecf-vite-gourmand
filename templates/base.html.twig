<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>{% block title %}Vite & Gourmand{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand d-flex align-items-center brand-logo" href="{{ path('app_home') }}">
                <span class="brand-icon">
                    <i class="bi bi-flower1"></i>
                </span>

                <span class="brand-logo"></span>
                <h5 class="brand-title">VITE & GOURMAND</h5>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_public_menus') }}">Menus</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_about') }}">À propos</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_livraison') }}">Livraison</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_contact') }}">Contact</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_public_galerie') }}">Galerie</a></li>
                </ul>
            </div>

            <div class="d-flex gap-3 align-items-center">

                {% if app.user %}

                <div class="dropdown">
                    <button class="account-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-check"></i>
                        <span>Mon espace</span>
                        <i class="bi bi-chevron-down small"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end account-dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_account') }}">
                                Mon compte
                            </a>
                        </li>

                        {% if is_granted('ROLE_ADMIN') %}
                        <li>
                            <a class="dropdown-item" href="{{ path('app_admin') }}">
                                Administration
                            </a>
                        </li>
                        {% endif %}

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                Déconnexion
                            </a>
                        </li>
                    </ul>
                </div>

                <a href="{{ path('app_account') }}" class="bag-link" title="Mes commandes">
                    <i class="bi bi-bag"></i>
                </a>

                {% else %}

                <a href="{{ path('app_login') }}" class="account-login-link">
                    <i class="bi bi-person"></i>
                    <span>Connexion</span>
                </a>

                <a href="{{ path('app_login') }}" class="bag-link" title="Se connecter">
                    <i class="bi bi-bag"></i>
                </a>

                {% endif %}

            </div>

        </div>
    </nav>

    {% for label, messages in app.flashes %}
    {% for message in messages %}
    <div class="site-flash site-flash-{{ label }}">
        {{ message }}
    </div>
    {% endfor %}
    {% endfor %}

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row">

                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="footer-brand-logo"><i class="bi bi-flower1"></i></span>
                        <h5 class="footer-brand-title">VITE & GOURMAND</h5>
                    </div>
                    <p>Repas gourmands préparés avec des produits frais et livrés rapidement chez vous.</p>
                    <div class="fs-4 d-flex gap-3">
                        <i class="bi bi-instagram"></i>
                        <i class="bi bi-whatsapp"></i>
                        <i class="bi bi-tiktok"></i>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="footer-title">Navigation</h6>
                    <a href="{{ path('app_home') }}" class="footer-link">Accueil</a>

                    <a href="{{ path('app_public_menus') }}" class="footer-link">Menus</a>

                    <a href="{{ path('app_about') }}" class="footer-link">À propos</a>

                    <a href="{{ path('app_livraison') }}" class="footer-link">Livraison</a>

                    <a href="{{ path('app_contact') }}" class="footer-link">Contact</a>
                </div>

                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="footer-title">Informations</h6>
                    <a href="{{ path('app_informations') }}#faq" class="footer-link">FAQ</a>
                    <a href="{{ path('app_informations') }}#mentions" class="footer-link">Mentions légales</a>
                    <a href="{{ path('app_informations') }}#confidentialite" class="footer-link">Politique de
                        confidentialité</a>
                    <a href="{{ path('app_informations') }}#conditions" class="footer-link">Conditions générales</a>
                    <a href="{{ path('app_informations') }}#cgv" class="footer-link">CGV</a>
                </div>

                <div class="col-lg-2 col-md-6 mb-4">
                    <div class="footer-col">
                        <h3 class="footer-hours-title">Horaires</h3>

                        <div class="footer-hours-list">
                            {% for horaire in get_horaires() %}
                            <div class="footer-hour-item">
                                <span class="footer-hour-day">{{ horaire.jour }}</span>
                                <span class="footer-hour-time">
                                    {{ horaire.heureOverture }} - {{ horaire.heureFermeture }}
                                </span>
                            </div>
                            {% else %}
                            <p>Horaires non renseignés.</p>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-4">
                    <h6 class="footer-title">Contact</h6>
                    <p><i class="bi bi-envelope"></i> alisazamkovaya@gmail.com</p>
                    <p><i class="bi bi-telephone"></i> 01 23 45 67 89</p>
                    <p><i class="bi bi-geo-alt"></i> Paris, France</p>
                </div>

            </div>
        </div>

        <div class="footer-bottom">
            2024 Vite & Gourmand - Tout droits réservés
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.js-confirm-form').forEach((form) => {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();

                    Swal.fire({
                        title: 'Confirmation',
                        text: form.dataset.confirmMessage,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#b68c5a',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Oui',
                        cancelButtonText: 'Annuler'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>

</body>

</html>