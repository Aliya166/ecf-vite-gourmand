{% extends 'base.html.twig' %}

{% block title %}{{ theme.libelle }} - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>{{ theme.libelle }}</h1>
                <p>Détail du thème sélectionné.</p>
            </div>

            <a href="{{ path('app_theme_index') }}" class="admin-back-btn">
                Retour aux thèmes
            </a>
        </div>

        <div class="admin-detail-card">

            <div class="admin-detail-section">
                <h2>Informations du thème</h2>

                <p><strong>ID :</strong> #{{ theme.id }}</p>
                <p><strong>Libellé :</strong> {{ theme.libelle }}</p>
            </div>

            <div class="admin-detail-actions">

                <a href="{{ path('app_theme_edit', {'id': theme.id}) }}"
                   class="admin-action-link admin-action-edit">
                    Modifier le thème
                </a>

                <a href="{{ path('app_admin') }}"
                   class="admin-action-link">
                    Retour au dashboard
                </a>

            </div>

        </div>

    </div>
</section>

{% endblock %}