{% extends 'base.html.twig' %}

{% block title %}Ajouter un thème - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Ajouter un thème</h1>
                <p>Créez un nouveau thème pour organiser les menus.</p>
            </div>

            <a href="{{ path('app_theme_index') }}" class="admin-back-btn">
                Retour aux thèmes
            </a>
        </div>

        <div class="admin-form-card">

            {{ form_start(form) }}

                <div class="admin-form-grid">
                    {{ form_row(form.libelle) }}
                </div>

                <button type="submit" class="admin-submit-btn">
                    Créer le thème
                </button>

            {{ form_end(form, {'render_rest': false}) }}

            <div class="admin-form-actions">
                <a href="{{ path('app_theme_index') }}" class="admin-action-link">
                    Retour à la liste
                </a>

                <a href="{{ path('app_admin') }}" class="admin-action-link">
                    Retour au dashboard
                </a>
            </div>

        </div>

    </div>
</section>

{% endblock %}