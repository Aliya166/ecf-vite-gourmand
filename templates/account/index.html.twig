{% extends 'base.html.twig' %}

{% block title %}Mon compte - Vite & Gourmand{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
<div class="alert alert-success">
    {{ message }}
</div>
{% endfor %}

<section class="account-page">
    <div class="container">

        <div class="account-header">
            <h1 class="section-title">Mon compte</h1>
            <p>Gérez vos informations personnelles et vos commandes.</p>
        </div>

        <div class="account-grid">

            <div class="account-card">
                <h2>Mes informations</h2>

                <div class="account-info">
                    <p><strong>Prénom :</strong> {{ user.firstname }}</p>
                    <p><strong>Nom :</strong> {{ user.lastname }}</p>
                    <p><strong>Email :</strong> {{ user.email }}</p>
                    <p><strong>Téléphone :</strong> {{ user.phone }}</p>
                    <p><strong>Adresse :</strong> {{ user.address }}</p>
                </div>

                <div class="account-actions">
                    <a href="{{ path('app_account_edit') }}" class="account-btn">
                        Modifier mes informations
                    </a>

                    <a href="{{ path('app_account_password') }}" class="account-btn account-btn-secondary">
                        Modifier mon mot de passe
                    </a>

                    <a href="{{ path('app_account_avis_new') }}" class="account-btn">
                        Laisser un avis
                    </a>
                </div>
            </div>

            <div class="account-card">
                <h2>Mes commandes</h2>

                {% if commandes is empty %}
                <p class="account-empty">
                    Aucune commande pour le moment.
                </p>

                <a href="{{ path('app_public_menus') }}" class="account-btn">
                    Voir les menus
                </a>
                {% else %}
                <div class="account-orders">
                    {% for commande in commandes %}
                    <div class="account-order-card">

                        <div class="account-order-header">
                            <h3>{{ commande.menu ? commande.menu.title : 'Menu indisponible' }}</h3>

                            <span class="order-status order-status-{{ commande.status }}">
                                {{ commande.status|replace({'_': ' '})|capitalize }}
                            </span>
                        </div>

                        <p>
                            <strong>Date :</strong>
                            {{ commande.dateCommande|date('d/m/Y H:i') }}
                        </p>

                        <p>
                            <strong>Nombre de personnes :</strong>
                            {{ commande.nombrePersonnes }}
                        </p>

                        {% if commande.commentaire %}
                        <p>
                            <strong>Commentaire :</strong>
                            {{ commande.commentaire }}
                        </p>
                        {% endif %}

                        {% if commande.status in ['en_attente', 'confirmee'] %}
                        <div class="account-order-actions">
                            <a href="{{ path('app_order_edit', {'id': commande.id}) }}" class="order-action-btn">
                                Modifier
                            </a>

                            <a href="{{ path('app_order_cancel', {'id': commande.id}) }}"
                                class="order-action-btn order-action-danger">
                                Annuler
                            </a>
                        </div>
                        {% endif %}

                    </div>
                    {% endfor %}
                </div>
                {% endif %}

            </div>

        </div>
</section>

{% endblock %}