{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe - Vite & Gourmand{% endblock %}

{% block body %}

<section class="auth-page">
    <div class="auth-card">

        <h1 class="auth-title">Modifier mon mot de passe</h1>

        <p class="auth-subtitle">
            Choisissez un nouveau mot de passe sécurisé.
        </p>

        {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
        {% endfor %}

        {{ form_start(passwordForm) }}

        {{ form_row(passwordForm.currentPassword) }}
        {{ form_row(passwordForm.newPassword.first) }}
        {{ form_row(passwordForm.newPassword.second) }}

        <button type="submit" class="auth-btn">
            Modifier mon mot de passe
        </button>

        {{ form_rest(passwordForm) }}
        {{ form_end(passwordForm) }}

        <div class="auth-links">
            <a href="{{ path('app_account') }}">
                Retour à mon compte
            </a>
        </div>

    </div>
</section>

{% endblock %}