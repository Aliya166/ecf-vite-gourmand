{% extends 'base.html.twig' %}

{% block title %}Nos menus - Vite & Gourmand{% endblock %}

{% block body %}

<h1 class="mb-4 text-center">Nos menus</h1>

<p class="text-center text-muted mb-5">
    Découvrez nos menus disponibles à la commande.
</p>

<div class="row">

    {% for menu in menus %}

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <img src="https://picsum.photos/400/250?random={{ menu.id }}" class="card-img-top" alt={{ menu.title }}">

            <div class="card-body">

                <h5 class="card-title">
                    {{ menu.title }}
                </h5>

                <p class="card-text">
                    {{ menu.description }}
                </p>

                <p class="fw-bold">
                    {{ menu.price }} €
                </p>

                <p>
                    <span class="badge bg-success">
                        {{ menu.regime ? menu.regime.libelle : 'Aucun régime' }}
                    </span>

                    <span class="badge bg-info text-dark">
                        {{ menu.theme ? menu.theme.libelle : 'Aucun thème' }}
                    </span>

                    <span class="badge bg-light text-dark border">
                        👥 {{ menu.nombrePersonneMinimum }}
                    </span>
                </p>

                <a href="{{ path('app_public_menu_show', {'id': menu.id}) }}" class="btn btn-warning w-100 mt-3">
                    Voir le menu
                </a>

            </div>

        </div>
    </div>

    {% else %}

    <div class="col-12">
        <p class="text-center">
            Aucun menu disponible pour le moment.
        </p>
    </div>

    {% endfor %}

</div>

{% endblock %}