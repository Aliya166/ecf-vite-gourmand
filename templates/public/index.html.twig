{% extends 'base.html.twig' %}

{% block title %}Nos menus - Vite & Gourmand{% endblock %}

{% block body %}

<section class="menus-hero-section">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h1 class="section-title menus-hero-title">
                Tous nos menus
            </h1>

            <p class="menus-hero-text">
                Découvrez notre sélection de menus préparés
                avec des produits frais et de saison.
            </p>
        </div>

        <div class="col-md-6">
            <img src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?q=80&w=1200" alt="Menus frais"
                class="menus-hero-img">
        </div>
    </div>
</section>

<section class="menus-filters-section">
    <div class="container">

        <form method="get" action="{{ path('app_public_menus') }}" class="menus-filters-form">

            <div class="menus-filters">

                <a href="{{ path('app_public_menus') }}"
                   class="filter-btn filter-btn-small {{ selectedTheme is empty and selectedRegime is empty and selectedMaxPrice is empty and selectedPersonnes is empty ? 'filter-btn-active' : '' }}">
                    Tous
                </a>

                <input
                    type="number"
                    name="maxPrice"
                    class="filter-btn filter-input {{ selectedMaxPrice is not empty ? 'filter-btn-active' : '' }}"
                    placeholder="Prix max"
                    min="0"
                    value="{{ selectedMaxPrice }}">

                <select name="theme"
                        class="filter-btn filter-select {{ selectedTheme is not empty ? 'filter-btn-active' : '' }}">
                    <option value="">Thème</option>

                    {% for theme in themes %}
                        <option value="{{ theme.id }}" {{ selectedTheme == theme.id ? 'selected' : '' }}>
                            {{ theme.libelle }}
                        </option>
                    {% endfor %}
                </select>

                <select name="regime"
                        class="filter-btn filter-select {{ selectedRegime is not empty ? 'filter-btn-active' : '' }}">
                    <option value="">Régime</option>

                    {% for regime in regimes %}
                        <option value="{{ regime.id }}" {{ selectedRegime == regime.id ? 'selected' : '' }}>
                            {{ regime.libelle }}
                        </option>
                    {% endfor %}
                </select>

                <input
                    type="number"
                    name="personnes"
                    class="filter-btn filter-input {{ selectedPersonnes is not empty ? 'filter-btn-active' : '' }}"
                    placeholder="Personnes"
                    min="1"
                    value="{{ selectedPersonnes }}">

                <button type="submit" class="filter-search-btn">
                    <i class="bi bi-search"></i>
                    Rechercher
                </button>

            </div>

        </form>

    </div>
</section>

<section class="menus-cards-section">
    <div class="container">
        <div class="row g-5">

            {% for menu in menus %}
            <div class="col-md-4">
                <div class="menu-page-card">

                    {% if menu.imageMain %}
                    <img src="{{ menu.imageMain }}" alt="{{ menu.title }}" class="menu-page-card-img">
                    {% else %}
                    <div class="menu-page-card-no-image">
                        Aucune photo
                    </div>
                    {% endif %}

                    <div class="menu-page-card-body">

                        <div class="d-flex justify-content-between align-items-start">
                            <h2 class="menu-page-card-title">
                                {{ menu.title }}
                            </h2>

                            <span class="menu-personnes">
                                <i class="bi bi-people-fill"></i>
                                {{ menu.nombrePersonneMinimum }}
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
                            <p class="menu-page-card-text">
                                {{ menu.description }}
                            </p>

                            <div class="menu-page-tags">

                                <span class="menu-tag">
                                    <span class="menu-tag-icon">
                                        <i class="bi bi-bookmark-star-fill"></i>
                                    </span>
                                    <span>{{ menu.theme.libelle }}</span>
                                </span>

                                <span class="menu-tag">
                                    <span class="menu-tag-icon">
                                        <i class="bi bi-flower1"></i>
                                    </span>
                                    <span>{{ menu.regime.libelle }}</span>
                                </span>

                            </div>
                        </div>

                        <div class="menu-separator"></div>

                        <p class="menu-page-card-price">
                            {{ menu.price }} €
                        </p>

                        <a href="{{ path('app_public_menu_show', {'id': menu.id}) }}" class="btn-menu-card">
                            Voir le menu
                        </a>

                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12">
                <p class="text-center">
                    Aucun menu disponible pour le moment.
                </p>
            </div>
            {% endfor %}

        </div>
    </div>
</section>

<section class="menus-pagination-section">
    <div class="menus-pagination">

        <a href="#" class="pagination-btn">
            <i class="bi bi-chevron-left"></i>
        </a>

        <a href="#" class="pagination-btn pagination-active">1</a>
        <a href="#" class="pagination-btn">2</a>
        <a href="#" class="pagination-btn">3</a>
        <a href="#" class="pagination-btn">4</a>
        <a href="#" class="pagination-btn">5</a>

        <a href="#" class="pagination-btn">
            <i class="bi bi-chevron-right"></i>
        </a>

    </div>
</section>

{% endblock %}