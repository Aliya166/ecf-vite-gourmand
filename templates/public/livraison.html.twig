{% extends 'base.html.twig' %}

{% block title %}À propos - Vite & Gourmand{% endblock %}

{% block body %}

<section class="py-5" style="background-color: #f2eadc;">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-md-6">
                <p class="text-uppercase fw-bold mb-2" style="color:#315c3b;">
                    Livraison rapide
                </p>

                <h1 class="display-4 hero-title mb-3">
                    Des repas frais livrés directement<br>
                    chez vous
                </h1>

                <p class="mb-4">
                    Profitez d'une livraison rapide et soignée partout dans votre secteur.
                    Nos repas sont préparés à la commande pour garantir fraîcheur, qualité et saveurs.
                </p>
            </div>

            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?q=80&w=1200"
                    class="img-fluid rounded shadow hero-image" alt="Repas frais">
            </div>

        </div>
    </div>
</section>


<section class="delivery-intro-section">
    <div class="container">
        <div class="delivery-intro-grid">

            <div class="delivery-intro-content">
                <span class="delivery-small-title">Notre service</span>
                <h2>Une livraison organisée avec soin</h2>

                <p>
                    Chez Vite & Gourmand, chaque livraison est préparée avec attention afin
                    de garantir fraîcheur, ponctualité et sérénité. Notre équipe organise
                    chaque commande à l’avance pour que vos menus arrivent dans les meilleures
                    conditions.
                </p>

                <p>
                    Nous livrons à l’adresse indiquée lors de la commande, selon les créneaux
                    disponibles et les informations transmises par le client.
                </p>
            </div>

            <div class="delivery-info-card">
                <div class="delivery-info-item">
                    <i class="bi bi-calendar-check"></i>
                    <span>Commande minimum 48h avant la livraison</span>
                </div>

                <div class="delivery-info-item">
                    <i class="bi bi-clock-history"></i>
                    <span>Livraison selon les créneaux disponibles</span>
                </div>

                <div class="delivery-info-item">
                    <i class="bi bi-person-check"></i>
                    <span>Suivi depuis le compte client</span>
                </div>

                <div class="delivery-info-item">
                    <i class="bi bi-headset"></i>
                    <span>Contact client en cas de besoin</span>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="delivery-process-section">
    <div class="container">

        <div class="delivery-section-heading">
            <span class="delivery-small-title">Étapes</span>
            <h2>Comment se passe la livraison ?</h2>
        </div>

        <div class="delivery-process-grid">

            <div class="delivery-step-card">
                <span class="delivery-step-number">1</span>
                <div class="delivery-step-icon">
                    <i class="bi bi-card-list"></i>
                </div>
                <h3>Choisissez votre menu</h3>
                <p>
                    Parcourez nos menus, sélectionnez la formule souhaitée et indiquez
                    le nombre de personnes.
                </p>
            </div>

            <div class="delivery-step-card">
                <span class="delivery-step-number">2</span>
                <div class="delivery-step-icon">
                    <i class="bi bi-clipboard-check"></i>
                </div>
                <h3>Validation de la commande</h3>
                <p>
                    Renseignez vos informations de livraison. L’équipe vérifie ensuite
                    les détails et confirme la commande.
                </p>
            </div>

            <div class="delivery-step-card">
                <span class="delivery-step-number">3</span>
                <div class="delivery-step-icon">
                    <i class="bi bi-egg-fried"></i>
                </div>
                <h3>Préparation avec soin</h3>
                <p>
                    Les menus sont préparés selon les stocks disponibles, les régimes
                    indiqués et les conditions du menu.
                </p>
            </div>

            <div class="delivery-step-card">
                <span class="delivery-step-number">4</span>
                <div class="delivery-step-icon">
                    <i class="bi bi-truck"></i>
                </div>
                <h3>Livraison à l’adresse prévue</h3>
                <p>
                    Votre commande est livrée au créneau convenu, prête à être dégustée.
                </p>
            </div>

        </div>

    </div>
</section>

<section class="delivery-tracking-section">
    <div class="container">

        <div class="delivery-tracking-card">
            <div class="delivery-tracking-content">
                <span class="delivery-small-title">Suivi</span>
                <h2>Suivi de commande</h2>
                <p>
                    Depuis votre compte client, vous pouvez consulter l’avancement de
                    votre commande à chaque étape.
                </p>
            </div>

            <div class="delivery-status-list">
                <span>En attente</span>
                <span>Confirmée</span>
                <span>En préparation</span>
                <span>Prête</span>
                <span>Livrée</span>
                <span>Terminée</span>
            </div>
        </div>

    </div>
</section>

<section class="delivery-material-section">
    <div class="container">
        <div class="delivery-material-card">

            <div class="delivery-material-image">
                <img src="{{ asset('images/livraison-materiel.jpg') }}" alt="Matériel de livraison Vite & Gourmand">
            </div>

            <div class="delivery-material-content">
                <span class="delivery-small-title">Matériel</span>
                <h2>Retour du matériel</h2>

                <p>
                    Certaines commandes peuvent nécessiter le retour du matériel de livraison :
                    contenants, plateaux, supports ou équipements spécifiques.
                </p>

                <p>
                    Dans ce cas, le client reçoit un message avec les informations nécessaires.
                    Le statut de la commande peut également indiquer qu’un retour matériel est attendu.
                </p>
            </div>

        </div>
    </div>
</section>

<section class="delivery-faq-section">
    <div class="container">

        <div class="delivery-section-heading">
            <span class="delivery-small-title">Questions fréquentes</span>
            <h2>Les informations utiles avant de commander</h2>
        </div>

        <div class="delivery-faq-grid">

            <div class="delivery-faq-item">
                <h3>Quel est le délai minimum pour commander ?</h3>
                <p>
                    Les commandes doivent être passées au minimum 48h avant la date
                    de livraison souhaitée, sous réserve de disponibilité.
                </p>
            </div>

            <div class="delivery-faq-item">
                <h3>Puis-je modifier ma commande ?</h3>
                <p>
                    Une commande peut être modifiée tant qu’elle est en attente ou confirmée.
                    Le menu choisi ne peut pas être remplacé : pour choisir un autre menu,
                    il faut créer une nouvelle commande.
                </p>
            </div>

            <div class="delivery-faq-item">
                <h3>Que se passe-t-il en cas de problème ?</h3>
                <p>
                    Notre équipe peut contacter le client par email ou par téléphone afin
                    de proposer une solution adaptée.
                </p>
            </div>

            <div class="delivery-faq-item">
                <h3>Où livrez-vous ?</h3>
                <p>
                    La livraison est proposée à Paris et en Île-de-France selon les zones,
                    les créneaux disponibles et les conditions de la commande.
                </p>
            </div>

        </div>

    </div>
</section>

<section class="delivery-cta-section">
    <div class="container">
        <div class="delivery-cta-box">

            <div>
                <span class="delivery-small-title">Vite & Gourmand</span>
                <h2>Prêt à organiser votre livraison ?</h2>
                <p>
                    Découvrez nos menus et choisissez la formule adaptée à votre prochain repas.
                </p>
            </div>

            <div class="delivery-cta-actions">
                <a href="{{ path('app_public_menus') }}" class="delivery-cta-main">
                    Découvrir nos menus
                    <i class="bi bi-arrow-right"></i>
                </a>
                <a href="{{ path('app_contact') }}" class="delivery-cta-secondary">
                    Nous contacter
                </a>
            </div>

        </div>
    </div>
</section>

{% endblock %}