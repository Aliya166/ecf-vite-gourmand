{% extends 'base.html.twig' %}

{% block title %}À propos - Vite & Gourmand{% endblock %}

{% block body %}

<section class="py-5" style="background-color: #f2eadc;">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-md-6">
                <p class="text-uppercase fw-bold mb-2" style="color:#315c3b;">
                    Livraison rapide
                </p>

                <h1 class="display-4 hero-title mb-3">
                    Des repas frais livrés directement<br>
                    chez vous
                </h1>

                <p class="mb-4">
                    Profitez d'une livraison rapide et soignée partout dans votre secteur.
                    Nos repas sont préparés à la commande pour garantir fraîcheur, qualité et saveurs.
                </p>
            </div>

            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?q=80&w=1200"
                    class="img-fluid rounded shadow hero-image" alt="Repas frais">
            </div>

        </div>
    </div>
</section>

<section class="info-cards-section">
    <div class="container">

        <div class="about-section-heading">
            <span class="section-kicker">Notre service</span>
            <h2>Une livraison pensée pour votre confort</h2>
            <p>
                Nous préparons vos commandes avec soin afin de vous proposer une expérience simple,
                rapide et agréable.
            </p>
        </div>

        <div class="about-team-grid">

            <div class="about-team-card">
                <div class="about-team-icon">
                    <i class="bi bi-truck"></i>
                </div>
                <h3>Livraison rapide</h3>
                <p>Vos repas sont livrés dans les meilleurs délais pour préserver leur fraîcheur.</p>
            </div>

            <div class="about-team-card">
                <div class="about-team-icon">
                    <i class="bi bi-basket2-fill"></i>
                </div>
                <h3>Produits frais</h3>
                <p>Chaque commande est préparée avec des ingrédients soigneusement sélectionnés.</p>
            </div>

            <div class="about-team-card">
                <div class="about-team-icon">
                    <i class="bi bi-geo-alt"></i>
                </div>
                <h3>Zone de livraison</h3>
                <p>Nous livrons à domicile ou sur votre lieu de travail selon votre secteur.</p>
            </div>

        </div>

    </div>
</section>

<section class="about-cuisine-section">
    <div class="container">
        <div class="about-cuisine-grid">

            <div class="about-cuisine-image">
                <img src="https://images.unsplash.com/photo-1526367790999-0150786686a2?auto=format&fit=crop&w=1200&q=80"
                     alt="Livraison de repas">
            </div>

            <div class="about-cuisine-content">
                <span class="section-kicker">Déroulement</span>

                <h2>Comment se passe la livraison ?</h2>

                <p>
                    Une fois votre commande validée, notre équipe prépare votre menu,
                    vérifie les informations importantes puis organise la livraison.
                </p>

                <div class="about-mini-list">
                    <div><i class="bi bi-check2-circle"></i> Commande validée en ligne</div>
                    <div><i class="bi bi-bag-check"></i> Repas préparé avec soin</div>
                    <div><i class="bi bi-house-heart"></i> Livraison à votre porte</div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="about-quality-section">
    <div class="container">
        <div class="about-quality-box">

            <div>
                <span class="section-kicker">Prêt à commander ?</span>
                <h2>Faites-vous livrer un repas frais et gourmand</h2>
                <p>
                    Découvrez nos menus et choisissez celui qui correspond à votre occasion.
                </p>
            </div>

            <a href="{{ path('app_public_menus') }}" class="about-link">
                    Voir les menus →
                </a>

        </div>
    </div>
</section>

{% endblock %}