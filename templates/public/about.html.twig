{% extends 'base.html.twig' %}

{% block title %}À propos - Vite & Gourmand{% endblock %}

{% block body %}

<section class="py-5" style="background-color: #f2eadc;">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-md-6">
                <p class="text-uppercase fw-bold mb-2" style="color:#315c3b;">
                    Notre histoire
                </p>

                <h1 class="display-4 hero-title mb-3">
                    A propos de Vite &<br>
                    Gourmand
                </h1>

                <p class="mb-4">
                    Des repas frais,gourmands et équilibrés,préparés avec soin et livré
                    rapidement chez vous.
                </p>

                <a href="{{ path('app_public_menus') }}" class="btn btn-green me-2">
                    Découvrir nos menus
                </a>
            </div>

            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?q=80&w=1200"
                    class="img-fluid rounded shadow hero-image" alt="Repas frais">
            </div>

        </div>
    </div>
</section>

<section class="about-story-section">
    <div class="container">
        <div class="about-story-grid">

            <div class="about-story-image">
                <img src="{{ asset('images/about-story.jpg') }}" alt="Préparation traiteur Vite & Gourmand">
            </div>

            <div class="about-story-content">
                <span class="about-small-title">Notre histoire</span>
                <h2>Une passion née à Paris</h2>

                <p>
                    Vite & Gourmand est né d’une idée simple : proposer des menus savoureux,
                    organisés et prêts à commander pour les repas du quotidien comme pour les
                    moments importants.
                </p>

                <p>
                    Nous accompagnons les familles, les particuliers et les entreprises avec
                    des formules claires, des produits frais et un service pensé pour simplifier
                    l’organisation de chaque repas.
                </p>

                <p class="about-signature">
                    Bien manger, bien recevoir, tout simplement.
                </p>
            </div>

        </div>
    </div>
</section>

<section class="about-values-section">
    <div class="container">

        <div class="about-section-heading">
            <span class="about-small-title">Nos valeurs</span>
            <h2>Une cuisine pensée avec soin</h2>
            <p>
                Chaque menu est conçu pour offrir une expérience simple, gourmande et fiable,
                de la commande jusqu’à la livraison.
            </p>
        </div>

        <div class="about-values-grid">

            <div class="about-value-card">
                <div class="about-icon">
                    <i class="bi bi-basket2" aria-hidden="true"></i>
                </div>
                <h3>Produits frais</h3>
                <p>
                    Nous privilégions des produits de saison et des préparations équilibrées
                    pour proposer des menus savoureux.
                </p>
            </div>

            <div class="about-value-card">
                <div class="about-icon">
                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                </div>
                <h3>Service ponctuel</h3>
                <p>
                    Les commandes sont organisées à l’avance afin de garantir une préparation
                    sérieuse et une livraison maîtrisée.
                </p>
            </div>

            <div class="about-value-card">
                <div class="about-icon">
                    <i class="bi bi-stars" aria-hidden="true"></i>
                </div>
                <h3>Présentation soignée</h3>
                <p>
                    Nos menus sont pensés pour être aussi agréables à regarder qu’à déguster,
                    quel que soit l’événement.
                </p>
            </div>

        </div>
    </div>
</section>

<section class="about-numbers-section">
    <div class="container">

        <div class="about-numbers-card">

            <div class="about-number-item">
                <span>48h</span>
                <p>Délai minimum pour organiser votre commande</p>
            </div>

            <div class="about-number-item">
                <span>100%</span>
                <p>Menus préparés avec soin et produits frais</p>
            </div>

            <div class="about-number-item">
                <span>6j/7</span>
                <p>Livraison selon les créneaux disponibles</p>
            </div>

            <div class="about-number-item">
                <span>Suivi</span>
                <p>Statut de commande visible depuis votre compte</p>
            </div>

        </div>

    </div>
</section>

<section class="about-process-section">
    <div class="container">

        <div class="about-section-heading">
            <span class="about-small-title">Notre fonctionnement</span>
            <h2>Comment nous préparons vos commandes</h2>
        </div>

        <div class="about-process-grid">

            <div class="about-process-step">
            <span class="about-step-number">1</span>
                <div class="about-process-icon">
                    <i class="bi bi-card-checklist" aria-hidden="true"></i>
                </div>
                <h3>Choisissez votre menu</h3>
                <p>
                    Parcourez les menus disponibles, choisissez une formule et indiquez
                    le nombre de personnes souhaité.
                </p>
            </div>

            <div class="about-process-step">
                <span class="about-step-number">2</span>
                <div class="about-process-icon">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                </div>
                <h3>Renseignez vos informations</h3>
                <p>
                    Ajoutez votre date de livraison, votre adresse, vos remarques et les
                    informations nécessaires à la préparation.
                </p>
            </div>

            <div class="about-process-step">
                <span class="about-step-number">3</span>
                <div class="about-process-icon">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                </div>
                <h3>Suivez votre commande</h3>
                <p>
                    Depuis votre compte, vous pouvez suivre l’évolution de votre commande
                    jusqu’à sa livraison.
                </p>
            </div>

        </div>

    </div>
</section>

<section class="about-team-section">
    <div class="container">
        <div class="about-team-grid">

            <div class="about-team-content">
                <span class="about-small-title">Notre engagement</span>
                <h2>Une équipe attentive à chaque détail</h2>

                <p>
                    Derrière chaque commande, il y a une organisation précise : sélection
                    des menus, préparation, suivi du statut, communication avec le client
                    et livraison.
                </p>

                <p>
                    Notre objectif est de proposer un service clair, humain et fiable,
                    pour que chaque client puisse commander en toute confiance.
                </p>

                <div class="about-team-points">
                    <div>
                        <i class="bi bi-headset" aria-hidden="true"></i>
                        <span>Écoute client</span>
                    </div>

                    <div>
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <span>Service fiable</span>
                    </div>

                    <div>
                        <i class="bi bi-heart" aria-hidden="true"></i>
                        <span>Satisfaction avant tout</span>
                    </div>
                </div>
            </div>

            <div class="about-team-image">
                <img src="{{ asset('images/about-team.jpg') }}" alt="Équipe Vite & Gourmand">
            </div>

        </div>
    </div>
</section>

<section class="about-cta-section">
    <div class="container">
        <div class="about-cta-box">

            <div>
                <span class="about-small-title">Vite & Gourmand</span>
                <h2>Prêts à régaler vos invités ?</h2>
                <p>
                    Découvrez nos menus et organisez votre prochain repas en quelques clics.
                </p>
            </div>

            <div class="about-cta-actions">
                <a href="{{ path('app_public_menus') }}" class="about-cta-main">
                    Découvrir nos menus
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>

                <a href="{{ path('app_contact') }}" class="about-cta-secondary">
                    Nous contacter
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                </a>
            </div>

        </div>
    </div>
</section>

{% endblock %}