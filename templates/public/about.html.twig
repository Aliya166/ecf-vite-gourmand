{% extends 'base.html.twig' %}

{% block title %}À propos - Vite & Gourmand{% endblock %}

{% block body %}

<section class="py-5" style="background-color: #f2eadc;">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-md-6">
                <p class="text-uppercase fw-bold mb-2" style="color:#315c3b;">
                    Notre histoire
                </p>

                <h1 class="display-4 hero-title mb-3">
                    A propos de Vite &<br>
                    Gourmand
                </h1>

                <p class="mb-4">
                    Des repas frais,gourmands et équilibrés,préparés avec soin et livré
                    rapidement chez vous.
                </p>

                <a href="{{ path('app_public_menus') }}" class="btn btn-green me-2">
                    Découvrir nos menus
                </a>
            </div>

            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?q=80&w=1200"
                    class="img-fluid rounded shadow hero-image" alt="Repas frais">
            </div>

        </div>
    </div>
</section>

<section class="about-cuisine-section">
    <div class="container">
        <div class="about-cuisine-grid">

            <div class="about-cuisine-image">
                <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?q=80&w=1200"
                     alt="Préparation des repas">
            </div>

            <div class="about-cuisine-content">
                <span class="section-kicker">Notre cuisine</span>

                <h2>Une cuisine préparée chaque jour</h2>

                <p>
                    Nos repas sont élaborés avec des produits frais et sélectionnés avec soin.
                    Chaque menu est préparé pour garantir goût, équilibre et simplicité.
                </p>

                <div class="about-mini-list">
                    <div><i class="bi bi-basket2-fill"></i> Produits frais</div>
                    <div><i class="bi bi-egg-fried"></i> Cuisine maison</div>
                    <div><i class="bi bi-flower1"></i> Ingrédients de saison</div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="about-team-section">
    <div class="container">

        <div class="about-section-heading">
            <span class="section-kicker">Notre équipe</span>
            <h2>Des personnes passionnées derrière chaque menu</h2>
            <p>
                De la préparation à la livraison, chaque étape est pensée pour offrir
                une expérience simple, humaine et gourmande.
            </p>
        </div>

        <div class="about-team-grid">

            <div class="about-team-card">
                <div class="about-team-icon">
                    <i class="bi bi-person-heart"></i>
                </div>
                <h3>Les cuisiniers</h3>
                <p>Ils imaginent et préparent les menus avec attention.</p>
            </div>

            <div class="about-team-card">
                <div class="about-team-icon">
                    <i class="bi bi-bag-check"></i>
                </div>
                <h3>La préparation</h3>
                <p>Chaque commande est vérifiée avant d’être envoyée.</p>
            </div>

            <div class="about-team-card">
                <div class="about-team-icon">
                    <i class="bi bi-truck"></i>
                </div>
                <h3>La livraison</h3>
                <p>Les repas sont livrés rapidement pour conserver leur fraîcheur.</p>
            </div>

        </div>

    </div>
</section>

<section class="about-quality-section">
    <div class="container">
        <div class="about-quality-box">

            <div>
                <span class="section-kicker">Notre engagement</span>
                <h2>Simple, frais et gourmand</h2>
                <p>
                    Vite & Gourmand met l’accent sur une expérience claire :
                    des menus bien présentés, des informations transparentes
                    et une commande facile à suivre depuis votre espace client.
                </p>
            </div>

            <a href="{{ path('app_public_menus') }}" class="about-link">
                    Voir les menus →
                </a>

        </div>
    </div>
</section>

{% endblock %}