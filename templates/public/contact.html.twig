{% extends 'base.html.twig' %}

{% block title %}À propos - Vite & Gourmand{% endblock %}

{% block body %}
{% for message in app.flashes('success') %}
<div class="contact-success-message">
    <i class="bi bi-check-circle-fill"></i>
    <div>
        <strong>Message envoyé avec succès !</strong>
        <p>{{ message }}</p>
    </div>
</div>
{% endfor %}

<section class="py-5" style="background-color: #f2eadc;">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-md-6">
                <p class="text-uppercase fw-bold mb-2" style="color:#315c3b;">
                    Nous contacter
                </p>

                <h1 class="display-4 hero-title mb-3">
                    Une question ?<br>
                    Nous sommes à votre écoute
                </h1>

                <p class="mb-4">
                    Notre équipe est disponible pour répondre à toutes vos questions
                    concernant les menus, les commandes ou la livraison.
                </p>
            </div>

            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?q=80&w=1200"
                    class="img-fluid rounded shadow hero-image" alt="Repas frais">
            </div>

        </div>
    </div>
</section>

<section class="info-cards-section">
    <div class="container">

        <div class="about-section-heading">
            <span class="section-kicker">Nos coordonnées</span>
            <h2>Contactez Vite & Gourmand</h2>
            <p>
                Pour toute question concernant une commande, un menu ou une livraison,
                vous pouvez nous contacter facilement.
            </p>
        </div>

        <div class="about-team-grid">

            <div class="about-team-card">
                <div class="about-team-icon">
                    <i class="bi bi-envelope"></i>
                </div>
                <h3>Email</h3>
                <p>contact@vitegourmand.fr</p>
            </div>

            <div class="about-team-card">
                <div class="about-team-icon">
                    <i class="bi bi-telephone"></i>
                </div>
                <h3>Téléphone</h3>
                <p>01 23 45 67 89</p>
            </div>

            <div class="about-team-card">
                <div class="about-team-icon">
                    <i class="bi bi-geo-alt"></i>
                </div>
                <h3>Adresse</h3>
                <p>Paris, France</p>
            </div>

        </div>

        <div class="contact-form-card">

            <form method="post" action="{{ path('app_contact') }}">
                <div class="admin-form-grid">
                    <div>
                        <label for="name">Nom complet</label>
                        <input type="text" id="name" name="name" required>
                    </div>

                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div>
                        <label for="phone">Téléphone</label>
                        <input type="text" id="phone" name="phone">
                    </div>

                    <div>
                        <label for="subject">Sujet</label>
                        <input type="text" id="subject" name="subject" required>
                    </div>
                </div>

                <div>
                    <label for="message">Message</label>
                    <textarea id="message" name="message" required></textarea>
                </div>

                <button type="submit" class="admin-submit-btn">
                    Envoyer le message
                </button>
            </form>
        </div>

    </div>
</section>

<section class="about-cuisine-section">
    <div class="container">
        <div class="about-cuisine-grid">

            <div class="about-cuisine-image">
                <img src="https://images.unsplash.com/photo-1556745757-8d76bdb6984b?auto=format&fit=crop&w=1200&q=80"
                    alt="Service client">
            </div>

            <div class="about-cuisine-content">
                <span class="section-kicker">Notre équipe</span>

                <h2>Une équipe disponible pour vous accompagner</h2>

                <p>
                    Nous répondons à vos demandes concernant les menus, les commandes,
                    les horaires ou les conditions de livraison.
                </p>

                <div class="about-mini-list">
                    <div><i class="bi bi-chat-dots"></i> Réponse aux questions</div>
                    <div><i class="bi bi-bag-check"></i> Suivi des commandes</div>
                    <div><i class="bi bi-clock"></i> Informations horaires</div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="about-quality-section">
    <div class="container">
        <div class="about-quality-box">

            <div>
                <span class="section-kicker">Une question ?</span>
                <h2>Nous sommes là pour vous aider</h2>
                <p>
                    Contactez-nous ou consultez nos menus pour préparer votre prochaine commande.
                </p>
            </div>

            <a href="{{ path('app_public_menus') }}" class="about-link">
                Voir les menus →
            </a>

        </div>
    </div>
</section>

{% endblock %}