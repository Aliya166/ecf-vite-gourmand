{% extends 'base.html.twig' %}

{% block title %}Modifier un employé - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Modifier l’employé</h1>
                <p>
                    Mettez à jour les informations personnelles de
                    {{ employee.firstname }} {{ employee.lastname }}.
                </p>
            </div>

            <a href="{{ path('app_employee_index') }}" class="admin-back-btn">
                Retour aux employés
            </a>
        </div>

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        <div class="admin-form-card">

            {{ form_start(form) }}

                <div class="admin-form-grid">

                    {{ form_row(form.firstname, {
                        label: 'Prénom'
                    }) }}

                    {{ form_row(form.lastname, {
                        label: 'Nom'
                    }) }}

                    {{ form_row(form.email, {
                        label: 'Adresse email'
                    }) }}

                    {{ form_row(form.phone, {
                        label: 'Téléphone'
                    }) }}

                    {{ form_row(form.address, {
                        label: 'Adresse'
                    }) }}

                </div>

                <div class="employee-edit-note">
                    <i class="bi bi-shield-lock"></i>

                    <p>
                        Le mot de passe n’est pas modifié depuis cette page.
                        L’employé peut changer son mot de passe depuis son compte personnel.
                    </p>
                </div>

                <button type="submit" class="admin-submit-btn">
                    Enregistrer les modifications
                </button>

            {{ form_end(form) }}

        </div>

    </div>
</section>

{% endblock %}