{% extends 'base.html.twig' %}

{% block title %}Modifier le statut - Vite & Gourmand{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Modifier le statut</h1>
                <p>Commande #{{ commande.id }} - {{ commande.menu.title }}</p>
            </div>

            <a href="{{ path('app_employee_dashboard') }}" class="admin-back-btn">
                Retour à l’espace employé
            </a>
        </div>

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <div class="admin-form-card">
            <form method="post">

                <label for="status">Statut de la commande</label>

                <select name="status" id="status" class="form-control">
                    <option value="en_attente" {{ commande.status == 'en_attente' ? 'selected' : '' }}>En attente</option>
                    <option value="confirmee" {{ commande.status == 'confirmee' ? 'selected' : '' }}>Confirmée</option>
                    <option value="en_preparation" {{ commande.status == 'en_preparation' ? 'selected' : '' }}>En préparation</option>
                    <option value="prete" {{ commande.status == 'prete' ? 'selected' : '' }}>Prête</option>
                    <option value="livree" {{ commande.status == 'livree' ? 'selected' : '' }}>Livrée</option>
                    <option value="terminee" {{ commande.status == 'terminee' ? 'selected' : '' }}>Terminée</option>
                    <option value="annulee" {{ commande.status == 'annulee' ? 'selected' : '' }}>Annulée</option>
                    <option value="en_attente_retour_materiel" {{ commande.status == 'en_attente_retour_materiel' ? 'selected' : '' }}>En attente du retour matériel</option>
                </select>

                <div id="cancelFields" class="cancel-fields" style="display: none; margin-top: 24px;">

                    <label for="modeContactClient">Mode de contact client</label>
                    <select name="modeContactClient" id="modeContactClient" class="form-control">
                        <option value="">Choisir un mode de contact</option>
                        <option value="appel_gsm" {{ commande.modeContactClient == 'appel_gsm' ? 'selected' : '' }}>Appel GSM</option>
                        <option value="email" {{ commande.modeContactClient == 'email' ? 'selected' : '' }}>Email</option>
                    </select>

                    <label for="motifAnnulation" style="margin-top: 16px;">Motif d’annulation</label>
                    <textarea
                        name="motifAnnulation"
                        id="motifAnnulation"
                        class="form-control"
                        rows="5"
                        placeholder="Expliquez le motif après contact avec le client.">{{ commande.motifAnnulation }}</textarea>

                    <p style="margin-top: 10px; font-size: 0.9rem; color: #6b5f55;">
                        Cette information est obligatoire si la commande est annulée.
                    </p>
                </div>

                <button type="submit" class="admin-submit-btn">
                    Enregistrer le statut
                </button>

            </form>
        </div>

    </div>
</section>

<script>
    const statusSelect = document.getElementById('status');
    const cancelFields = document.getElementById('cancelFields');

    function toggleCancelFields() {
        if (statusSelect.value === 'annulee') {
            cancelFields.style.display = 'block';
        } else {
            cancelFields.style.display = 'none';
        }
    }

    statusSelect.addEventListener('change', toggleCancelFields);
    toggleCancelFields();
</script>

{% endblock %}