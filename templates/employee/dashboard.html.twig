{% extends 'base.html.twig' %}

{% block title %}Espace employé - Vite & Gourmand{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Espace employé</h1>
                <p>Consultez les commandes et mettez à jour leur statut.</p>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <div class="admin-table-card">
            {% if commandes is empty %}
                <p class="admin-empty">Aucune commande pour le moment.</p>
            {% else %}
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Client</th>
                                <th>Menu</th>
                                <th>Livraison</th>
                                <th>Total</th>
                                <th>Statut</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for commande in commandes %}
                                <tr>
                                    <td>#{{ commande.id }}</td>

                                    <td>
                                        {{ commande.user.firstname }} {{ commande.user.lastname }}<br>
                                        <small>{{ commande.user.email }}</small>
                                    </td>

                                    <td>
                                        {{ commande.menu ? commande.menu.title : 'Menu indisponible' }}
                                    </td>

                                    <td>
                                        {{ commande.dateLivraison|date('d/m/Y') }}
                                        à
                                        {{ commande.heureLivraison|date('H:i') }}<br>
                                        <small>{{ commande.adresseLivraison }}, {{ commande.villeLivraison }}</small>
                                    </td>

                                    <td>
                                        {{ commande.prixTotal|number_format(2, ',', ' ') }} €
                                    </td>

                                    <td>
                                        <span class="order-status order-status-{{ commande.status }}">
                                            {{ commande.status|replace({'_': ' '})|capitalize }}
                                        </span>
                                    </td>

                                    <td>
                                        <a href="{{ path('app_employee_order_status', {'id': commande.id}) }}" class="admin-action-link">
                                            Modifier statut
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

    </div>
</section>

{% endblock %}