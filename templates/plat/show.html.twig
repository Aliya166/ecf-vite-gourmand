{% extends 'base.html.twig' %}

{% block title %}Plat{% endblock %}

{% block body %}
    <h1>Plat</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ plat.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ plat.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ plat.description }}</td>
            </tr>
            <tr>
                <th>TypePlat</th>
                <td>{{ plat.typePlat }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ plat.price }}</td>
            </tr>
            <tr>
                <th>Menu</th>
                <td>{{ plat.menu ? plat.menu.title : 'Aucun menu' }}</td>
            </tr>
            <tr>
                <th>IsActive</th>
                <td>{{ plat.isActive ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreateAt</th>
                <td>{{ plat.createAt ? plat.createAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Allergenes</th>
                <td>
                    {% for allergene in plat.allergenes %}
                        {{ allergene.libelle }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        Aucun allergène
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <th>Photo</th>
                <td>{{ plat.photo ?: 'Aucune photo' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_plat_index') }}">back to list</a>

    <a href="{{ path('app_plat_edit', {'id': plat.id}) }}">edit</a>

    {{ include('plat/_delete_form.html.twig') }}
{% endblock %}
