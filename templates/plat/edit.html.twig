{% extends 'base.html.twig' %}

{% block title %}Modifier {{ plat.name }} - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Modifier {{ plat.name }}</h1>
                <p>Mettez à jour les informations, la photo, les menus et les allergènes du plat.</p>
            </div>

            <a href="{{ path('app_plat_index') }}" class="admin-back-btn">
                Retour aux plats
            </a>
        </div>

        <div class="admin-form-card">

            {{ form_start(form) }}

            <div class="admin-form-grid">
                {{ form_row(form.name) }}
                {{ form_row(form.typePlat) }}
                {{ form_row(form.price) }}
                {{ form_row(form.photo) }}
                {{ form_row(form.isActive) }}
                {{ form_row(form.createAt) }}
                {{ form_row(form.description) }}
            </div>

            <div class="admin-form-full">
                <h2>Menus associés</h2>
                {{ form_row(form.menus) }}
            </div>

            <div class="admin-form-full">
                <h2>Allergènes</h2>
                {{ form_row(form.allergenes) }}
            </div>

            <button type="submit" class="admin-submit-btn">
                Enregistrer les modifications
            </button>

            {{ form_rest(form) }}
            {{ form_end(form) }}

            <div class="admin-form-actions">
                <a href="{{ path('app_plat_show', {'id': plat.id}) }}" class="admin-action-link">
                    Voir le plat
                </a>

                <a href="{{ path('app_admin') }}" class="admin-action-link">
                    Retour au dashboard
                </a>
            </div>

        </div>

    </div>
</section>

{% endblock %}