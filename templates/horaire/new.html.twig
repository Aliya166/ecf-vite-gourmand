{% extends 'base.html.twig' %}

{% block title %}Ajouter un horaire - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Ajouter un horaire</h1>
                <p>Créez un nouvel horaire qui sera affiché dans le footer du site.</p>
            </div>

            <a href="{{ path('app_horaire_index') }}" class="admin-back-btn">
                Retour aux horaires
            </a>
        </div>

        <div class="admin-form-card">

            {{ form_start(form) }}

                <div class="admin-form-grid">
                    {{ form_row(form.jour) }}
                    {{ form_row(form.heureOverture) }}
                    {{ form_row(form.heureFermeture) }}
                </div>

                <button type="submit" class="admin-submit-btn">
                    Créer l’horaire
                </button>

            {{ form_end(form, {'render_rest': false}) }}

            <div class="admin-form-actions">
                <a href="{{ path('app_horaire_index') }}" class="admin-action-link">
                    Retour à la liste
                </a>

                <a href="{{ path('app_admin') }}" class="admin-action-link">
                    Retour au dashboard
                </a>
            </div>

        </div>

    </div>
</section>

{% endblock %}