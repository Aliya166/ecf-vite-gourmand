{% extends 'base.html.twig' %}

{% block title %}Gestion des horaires - Vite & Gourmand{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Gestion des horaires</h1>
                <p>Créez, consultez et modifiez les horaires affichés sur le site.</p>
            </div>

            <div class="admin-header-actions">
                <a href="{{ path('app_dashboard_redirect') }}" class="admin-back-btn">
                    Retour au dashboard
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_menu_new') }}" class="admin-submit-btn">
                    Ajouter un menu
                </a>
                {% endif %}
            </div>
        </div>

        <div class="admin-table-card">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Jour</th>
                        <th>Ouverture</th>
                        <th>Fermeture</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for horaire in horaires %}
                        <tr>
                            <td>#{{ horaire.id }}</td>
                            <td><strong>{{ horaire.jour }}</strong></td>
                            <td>{{ horaire.heureOverture }}</td>
                            <td>{{ horaire.heureFermeture }}</td>
                            <td>
                                <div class="admin-actions">
                                    <a href="{{ path('app_horaire_show', {'id': horaire.id}) }}" class="admin-action-link">
                                        Voir
                                    </a>

                                    <a href="{{ path('app_horaire_edit', {'id': horaire.id}) }}" class="admin-action-link admin-action-edit">
                                        Modifier
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5">Aucun horaire trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</section>

{% endblock %}