{% extends 'base.html.twig' %}

{% block title %}Modifier {{ horaire.jour }} - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Modifier {{ horaire.jour }}</h1>
                <p>Mettez à jour les horaires affichés dans le footer du site.</p>
            </div>

            <a href="{{ path('app_horaire_index') }}" class="admin-back-btn">
                Retour aux horaires
            </a>
        </div>

        <div class="admin-form-card">

            {{ form_start(form) }}

            <div class="admin-form-grid">
                {{ form_row(form.jour) }}
                {{ form_row(form.heureOverture) }}
                {{ form_row(form.heureFermeture) }}
            </div>

            <button type="submit" class="admin-submit-btn">
                Enregistrer les modifications
            </button>

            {{ form_rest(form) }}
            {{ form_end(form) }}

            <div class="admin-form-actions">
                <a href="{{ path('app_horaire_show', {'id': horaire.id}) }}" class="admin-action-link">
                    Voir l’horaire
                </a>

                <a href="{{ path('app_admin') }}" class="admin-action-link">
                    Retour au dashboard
                </a>
            </div>

        </div>

    </div>
</section>

{% endblock %}