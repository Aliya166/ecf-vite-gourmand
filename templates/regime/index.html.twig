{% extends 'base.html.twig' %}

{% block title %}Gestion des régimes - Vite & Gourmand{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Gestion des régimes</h1>
                <p>Créez, consultez et modifiez les régimes alimentaires utilisés pour les menus.</p>
            </div>

            <div class="admin-header-actions">
                <a href="{{ path('app_admin') }}" class="admin-back-btn">
                    Retour au dashboard
                </a>

                <a href="{{ path('app_regime_new') }}" class="admin-create-btn">
                    Ajouter un régime
                </a>
            </div>
        </div>

        <div class="admin-table-card">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Libellé</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for regime in regimes %}
                        <tr>
                            <td>#{{ regime.id }}</td>

                            <td>
                                <strong>{{ regime.libelle }}</strong>
                            </td>

                            <td>
                                <div class="admin-actions">
                                    <a href="{{ path('app_regime_show', {'id': regime.id}) }}" class="admin-action-link">
                                        Voir
                                    </a>

                                    <a href="{{ path('app_regime_edit', {'id': regime.id}) }}" class="admin-action-link admin-action-edit">
                                        Modifier
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">Aucun régime trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</section>

{% endblock %}