{% extends 'base.html.twig' %}

{% block title %}Ajouter un menu - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Ajouter un menu</h1>
                <p>Créez un nouveau menu avec ses informations, ses photos et ses plats.</p>
            </div>

            <a href="{{ path('app_menu_index') }}" class="admin-back-btn">
                Retour aux menus
            </a>
        </div>

        <div class="admin-form-card">

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            <div class="admin-form-grid">
                {{ form_row(form.title) }}
                {{ form_row(form.nombrePersonneMinimum) }}
                {{ form_row(form.description) }}
                {{ form_row(form.price) }}

                {{ form_row(form.imageMainFile) }}
                {{ form_row(form.imageSecondFile) }}
                {{ form_row(form.imageThirdFile) }}
                {{ form_row(form.imageFourthFile) }}

                {{ form_row(form.isActive) }}
                {{ form_row(form.createAt) }}
                {{ form_row(form.regime) }}
                {{ form_row(form.theme) }}
            </div>

            <div class="admin-form-full">
                <h2>Plats du menu</h2>
                {{ form_row(form.platsMany) }}
            </div>

            <button type="submit" class="admin-submit-btn">
                Créer le menu
            </button>

            {{ form_rest(form) }}
            {{ form_end(form) }}

            <div class="admin-form-actions">
                <a href="{{ path('app_menu_index') }}" class="admin-action-link">
                    Retour à la liste
                </a>

                <a href="{{ path('app_admin') }}" class="admin-action-link">
                    Retour au dashboard
                </a>
            </div>

        </div>

    </div>
</section>

{% endblock %}