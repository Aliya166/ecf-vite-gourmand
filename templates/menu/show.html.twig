{% extends 'base.html.twig' %}

{% block title %}Menu{% endblock %}

{% block body %}
<h1>Menu</h1>

<table class="table">
    <tbody>
        <tr>
            <th>Id</th>
            <td>{{ menu.id }}</td>
        </tr>
        <tr>
            <th>Title</th>
            <td>{{ menu.title }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ menu.description }}</td>
        </tr>
        <tr>
            <th>Price</th>
            <td>{{ menu.price }}</td>
        </tr>
        <tr>
            <th>IsActive</th>
            <td>{{ menu.isActive ? 'Yes' : 'No' }}</td>
        </tr>
        <tr>
            <th>CreateAt</th>
            <td>{{ menu.createAt ? menu.createAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        <tr>
            <th>Plats</th>
            <td>
                {% for plat in menu.plats %}
                <div>{{ plat.name }}</div>
                {% else %}
                <span>Aucun plat associé</span>
                {% endfor %}
            </td>
        </tr>
        <tr>
            <th>Regime</th>
            <td>{{ menu.regime ? menu.regime.libelle : 'Aucun régime' }}</td>
        </tr>
        <tr>
            <th>Theme</th>
            <td>{{ menu.theme ? menu.theme.libelle : 'Aucun thème' }}</td>
        </tr>
    </tbody>
</table>

<a href="{{ path('app_menu_index') }}">back to list</a>

<a href="{{ path('app_menu_edit', {'id': menu.id}) }}">edit</a>

{{ include('menu/_delete_form.html.twig') }}
{% endblock %}