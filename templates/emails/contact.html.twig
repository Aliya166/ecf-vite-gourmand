<div style="font-family: Arial, sans-serif; background-color: #f7f1e8; padding: 30px;">
    <div style="max-width: 650px; margin: 0 auto; background: #ffffff; border-radius: 18px; padding: 30px;">

        <h1 style="color: #2f5d45;">Nouveau message de contact</h1>

        <p>
            Un nouveau message a été envoyé depuis le formulaire de contact du site
            <strong>Vite & Gourmand</strong>.
        </p>

        <div style="background-color: #f7f1e8; border-radius: 14px; padding: 20px; margin: 20px 0;">
            <p><strong>Nom :</strong> {{ name }}</p>
            <p><strong>Email :</strong> {{ senderEmail }}</p>
            <p><strong>Téléphone :</strong> {{ phone ?: 'Non renseigné' }}</p>
            <p><strong>Sujet :</strong> {{ subject }}</p>
        </div>

        <h2 style="color: #2f5d45;">Message</h2>

        <p style="line-height: 1.7;">
            {{ message|nl2br }}
        </p>

        <p style="margin-top: 30px;">
            Vous pouvez répondre directement à cet email pour contacter la personne.
        </p>

    </div>
</div>