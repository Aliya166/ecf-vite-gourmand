{% extends 'base.html.twig' %}

{% block title %}Gestion des avis - Vite & Gourmand{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>Gestion des avis</h1>
                <p>Consultez et modérez les avis laissés par les clients.</p>
            </div>

            <div class="admin-header-actions">
                <a href="{{ path('app_dashboard_redirect') }}" class="admin-back-btn">
                    Retour au dashboard
                </a>
            </div>
        </div>

        <div class="admin-table-card">
            <table class="admin-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Note</th>
                        <th>Avis</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                {% for avi in avis %}

                    <tr>

                        <td>#{{ avi.id }}</td>

                        <td>
                            {{ avi.user.email }}
                        </td>

                        <td>
                            ⭐ {{ avi.note }}/5
                        </td>

                        <td>
                            {{ avi.description|slice(0,80) }}
                            {% if avi.description|length > 80 %}...{% endif %}
                        </td>

                        <td>

                            {% if avi.status == 'approuve' %}
                                <span class="order-status order-status-confirmee">
                                    Approuvé
                                </span>

                            {% elseif avi.status == 'refuse' %}
                                <span class="order-status order-status-annulee">
                                    Refusé
                                </span>

                            {% else %}
                                <span class="order-status order-status-attente">
                                    En attente
                                </span>

                            {% endif %}

                        </td>

                        <td>

                            <div class="admin-actions">

                                <a href="{{ path('app_avis_show', {'id': avi.id}) }}"
                                   class="admin-action-link">
                                    Voir
                                </a>

                                <a href="{{ path('app_avis_edit', {'id': avi.id}) }}"
                                   class="admin-action-link admin-action-edit">
                                    Modérer
                                </a>

                            </div>

                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="6">
                            Aucun avis trouvé.
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>
        </div>

    </div>
</section>

{% endblock %}