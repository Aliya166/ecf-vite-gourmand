{% extends 'base.html.twig' %}

{% block title %}Administration - Vite & Gourmand{% endblock %}

{% block body %}

<section class="admin-dashboard">
    <div class="container">

        <div class="admin-header">
            <h1>Dashboard Administrateur</h1>
            <p>Gérez les contenus, les menus, les commandes et les utilisateurs du site.</p>
        </div>

        <div class="admin-grid">

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-journal-richtext"></i>
                </div>
                <h2>Menus</h2>
                <p>Créer, modifier ou supprimer les menus proposés aux clients.</p>
                <a href="{{ path('app_menu_index') }}" class="admin-btn">Gérer les menus</a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-cup-hot"></i>
                </div>
                <h2>Plats</h2>
                <p>Gérer les plats associés aux menus et leurs informations.</p>
                <a href="{{ path('app_plat_index') }}" class="admin-btn">Gérer les plats</a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <h2>Commandes</h2>
                <p>Consulter et gérer les commandes effectuées par les clients.</p>
                <a href="{{ path('app_commande_index') }}" class="admin-btn">Voir les commandes</a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-images"></i>
                </div>
                <h2>Galerie</h2>
                <p>Ajouter, modifier ou supprimer les photos de la galerie.</p>
                <a href="{{ path('app_gallery_image_index') }}" class="admin-btn">Gérer la galerie</a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-clock"></i>
                </div>
                <h2>Horaires</h2>
                <p>Mettre à jour les horaires affichés dans le pied de page.</p>
                <a href="{{ path('app_horaire_index') }}" class="admin-btn">Gérer les horaires</a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-stars"></i>
                </div>
                <h2>Thèmes</h2>
                <p>Gérer les thèmes associés aux menus.</p>
                <a href="{{ path('app_theme_index') }}" class="admin-btn">Gérer les thèmes</a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-tree"></i>
                </div>
                <h2>Régimes</h2>
                <p>Gérer les régimes alimentaires des menus.</p>
                <a href="{{ path('app_regime_index') }}" class="admin-btn">Gérer les régimes</a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h2>Allergènes</h2>
                <p>Gérer les allergènes associés aux plats.</p>
                <a href="{{ path('app_allergene_index') }}" class="admin-btn">Gérer les allergènes</a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-star"></i>
                </div>
                <h2>Avis</h2>
                <p>Consulter et modérer les avis laissés par les clients.</p>

                <a href="{{ path('app_avis_index') }}" class="admin-btn">
                    Gérer les avis
                </a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h2>Employés</h2>

                <p>
                    Créer, consulter et gérer les comptes employés.
                </p>

                <a href="{{ path('app_employee_index') }}" class="admin-btn">
                    Gérer les employés
                </a>
            </div>

            <div class="admin-card">
                <div class="admin-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </div>
                <h2>Statistiques</h2>

                <p>
                    Consulter les commandes, le chiffre d'affaires par menu et les données NoSQL.
                </p>

                <a href="{{ path('app_admin_statistics') }}" class="admin-btn">
                    Voir les statistiques
                </a>
            </div>


        </div>

    </div>
</section>

{% endblock %}