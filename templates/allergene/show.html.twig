{% extends 'base.html.twig' %}

{% block title %}{{ allergene.libelle }} - Administration{% endblock %}

{% block body %}

<section class="admin-list-page">
    <div class="container">

        <div class="admin-page-header">
            <div>
                <h1>{{ allergene.libelle }}</h1>
                <p>Détail de l’allergène sélectionné.</p>
            </div>

            <a href="{{ path('app_allergene_index') }}" class="admin-back-btn">
                Retour aux allergènes
            </a>
        </div>

        <div class="admin-detail-card">

            <div class="admin-detail-section">
                <h2>Informations de l’allergène</h2>

                <p><strong>ID :</strong> #{{ allergene.id }}</p>
                <p><strong>Libellé :</strong> {{ allergene.libelle }}</p>
            </div>

            <div class="admin-detail-actions">

                <a href="{{ path('app_allergene_edit', {'id': allergene.id}) }}"
                   class="admin-action-link admin-action-edit">
                    Modifier l’allergène
                </a>

                <a href="{{ path('app_admin') }}"
                   class="admin-action-link">
                    Retour au dashboard
                </a>

            </div>

        </div>

    </div>
</section>

{% endblock %}